# Copy to .env and adjust for local development.

# --- Backend ---
# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://resumeforge:resumeforge@localhost:5432/resumeforge

# Redis (queue/cache)
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO / S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumeforge

# Local LLM (Ollama) - optional, used for AI generation
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Resume Copilot ---
# Local-only assistant. COPILOT_ values override OLLAMA_* for copilot calls.
# The deterministic fallback answers even when Ollama is off.
COPILOT_LLM_ENABLED=true
COPILOT_OLLAMA_BASE_URL=http://localhost:11434
COPILOT_OLLAMA_MODEL=qwen2.5-coder:7b
# Resource bounds (server-side; clients cannot raise these)
COPILOT_MAX_SUGGESTIONS=8
COPILOT_MAX_TARGET_TEXT_CHARS=2000
COPILOT_MAX_PROMPT_CHARS=12000
COPILOT_MAX_RESPONSE_CHARS=12000
COPILOT_MAX_EVIDENCE_PER_SUGGESTION=5
# Max length of a single proposed edit value (Phase 7C apply/revert model).
COPILOT_MAX_EDIT_VALUE_CHARS=4000
COPILOT_LLM_REQUEST_TIMEOUT_SECONDS=120
COPILOT_LLM_AVAILABILITY_TIMEOUT_SECONDS=2.5
# Must fit the full structured JSON response; too small truncates and forces fallback.
COPILOT_LLM_MAX_TOKENS=2048

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
