{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "excludeFiles": [
        ".venv/**",
        "ml/**",
        "tests/**",
        "**/__pycache__/**",
        "**/*.egg-info/**",
        ".pytest_cache/**",
        ".ruff_cache/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}